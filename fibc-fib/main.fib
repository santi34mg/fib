// Fib implementation of the fibc compiler

comp Option := std::option::Option;

comp Token: type = struct {
    pos: uint32,
    line: uint32,
    row: uint32,
    kind: TokenKind,
};
comp TokenKind: type = enum {
    Literal: TokenLiteral,
    Keyword: TokenKeyword,
    Punctuation: TokenPunctuation,
    Operator: TokenOperator,
    Unknown: uint8,
    Comment,
    Error: const []uint8,
};
comp TokenLiteral: type = enum {
    Integer: uint64,
    Float: const []uint8,
    Boolean: bool,
    Character: uint8,
    String: const []uint8,
    CString: const []uint8,
    Null,
};
comp TokenKeyword: type = enum {
    Var,
    Const,
    Pub,
    Comp,
    If,
    Else,
    While,
    Break,
    Continue,
    Return,
    Function,
    Switch,
    When,
    Struct,
    Enum,
    Union,
    As,
    Extern,
    Callconv,
    Defer,
    Import,
};
comp TokenPunctuation: type = enum {
    OpeningParenthesis,
    ClosingParenthesis,
    OpeningCurlyBrace,
    ClosingCurlyBrace,
    OpeningSquareBrace,
    ClosingSquareBrace,
    Semicolon,
    Comma,
    Colon,
    DoubleColon,
    Dot,
    // Reserved for future attribute/decorator syntax; not consumed by the parser yet.
    At,
};
comp TokenOperator: type = enum {
    Plus,               // +
    Minus,              // -
    Star,               // *
    Slash,              // /
    Percent,            // %
    GreaterThan,        // >
    LesserThan,         // <
    GreaterEqual,       // >=
    LesserEqual,        // <=
    LeftShift,          // <<
    RightShift,         // >>
    Assign,             // =
    Def,                // :=
    DoubleEquals,       // ==
    Different,          // !=
    PlusAssign,         // +=
    MinusAssign,        // -=
    StarAssign,         // *=
    SlashAssign,        // /=
    PercentAssign,      // %=
    LogicalAnd,         // &&
    LogicalOr,          // ||
    LogicalNot,         // !
    Ampersand,          // &
    Pipe,               // |
    Tilde,              // ~
    Caret,              // ^
    DoubleDot,          // ..
    DotEq,              // .=
    Ellipsis,           // ...
    ThinRightArrow,     // ->
    AddressOf,          // .&
    Dereference,        // .*
};

comp CompilerErr: type = enum {
    MissingArgs,
    NotImplemented,
    Lexer,
    Parser,
    Analyzer,
    Ir,
    Lowering,
};

fn main(args: std::process::Arguments, env: std::process::Environment) std::result::Result(void, CompilerErr) {
    if args.len < 2 {
        std::io::print("usage: fibc-fib <filename>");
        return std::result::Result(void, CompilerErr).Err(CompilerErr.MissingArgs);
    };
    command := args[1];
    if std::string::eq(command, "build") {
        build_cmd();
    } else if std::string::eq(command, "run") {
        return std::result::Result(void, CompilerErr).Err(CompilerErr.NotImplemented);
    } else if std::string::eq(command, "test") {
        return std::result::Result(void, CompilerErr).Err(CompilerErr.NotImplemented);
    };


    return std::result::Result(void, CompilerErr).Ok;
}

fn build_cmd() void {

}


comp StandardLibrary := struct {
    enabled: bool,
    sysroot: Option(PathBuf),
    loaded: Option(Registration),
};

/// BuilderObject uses the builder pattern to create an object that
/// guides the build process of the project.
comp PlanBuilder := struct {
    standard_library: StandardLibrary,
    /// True if the build configuration is done
    build_stage: BuildStage,
    /// Main file that orchestrates the compilation process
    // note that PathBuf is owning
    build_file: PathBuf,
    /// Modules defined in the build file
    modules: Vec(PathBuf),
    native: NativeInputs,
    /// Logical entry source selected by the interpreted build file.
    entry_name: Option(String),
    /// Output path selected by the interpreted build file.
    output: Option(PathBuf),
    /// Optimization level passed to clang as `-O<level>`.
    /// Accepted: `0`, `1`, `2`, `3`, `s`, `z`.
    _opt_level: Option(String),
};
