pub comp SHUT_WR: int32 = 1;
pub comp SHUT_RDWR: int32 = 2;
pub comp SOL_SOCKET: int32 = 0xffff;
pub comp SO_REUSEADDR: int32 = 0x4;
pub comp SO_KEEPALIVE: int32 = 0x8;
