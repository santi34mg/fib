// *at directory and flag arguments.
pub comp AT_FDCWD: int32 = -2;
pub comp AT_SYMLINK_NOFOLLOW: int32 = 0x20;
pub comp AT_SYMLINK_FOLLOW: int32 = 0x40;
pub comp AT_REMOVEDIR: int32 = 0x80;

// lseek whence.
pub comp SEEK_SET: int32 = 0;
pub comp SEEK_CUR: int32 = 1;
