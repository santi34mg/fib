// Sockets.
pub comp AF_UNIX: int32 = 1;
pub comp AF_INET: int32 = 2;
pub comp AF_INET6: int32 = 30;
pub comp SOCK_STREAM: int32 = 1;
pub comp SOCK_DGRAM: int32 = 2;
pub comp SOCK_RAW: int32 = 3;
