// macOS (Apple arm64) implementation of std::os over libSystem (std::libc).
//
// The public API mirrors the Linux implementation: the same function names,
// Errno/Result aliases, Stat fields and constant names, with darwin values.
// Differences:
// - No raw syscalls: syscall0-6 exist for name resolution but are rejected by
//   the backend, and std::syscall is unavailable on this target.
// - Linux-only operations and flags are absent: getdents64, accept4, sbrk,
//   O_DIRECT, O_NOATIME, O_PATH, O_TMPFILE, AT_EMPTY_PATH, CLOCK_BOOTTIME,
//   SOCK_NONBLOCK and SOCK_CLOEXEC. Using them fails at name resolution.
// - pipe2 and dup3 emulate their flags with fcntl after the call (not atomic).
// - getrandom reads at most 256 bytes per call (getentropy) and ignores flags.
// - Utsname uses darwin's five 256-byte fields (no domainname).
// - exit uses _exit: no atexit handlers or stdio flushing, like exit_group.
//
// Typed wrappers return a Result whose Err variant carries an Errno (darwin's
// positive error number). Like the Linux wrappers, they never retry EINTR or
// complete short transfers; use std::io::read_full and std::io::write_all.

comp libc := root::libc;

pub comp Errno := int32;

pub comp CountResult := root::result::Result(usize, Errno);
pub comp IntResult := root::result::Result(int32, Errno);
pub comp OffsetResult := root::result::Result(int64, Errno);
pub comp MappingResult := root::result::Result(*uint8, Errno);
pub comp Status := root::result::Result(void, Errno);

// Two descriptors. For pipes, first is the read end and second the write end.
pub comp FdPair := struct { first: int32, second: int32 };
pub comp FdPairResult := root::result::Result(FdPair, Errno);

// struct timespec.
pub comp Timespec := struct { seconds: int64, nanoseconds: int64 };
pub comp TimeResult := root::result::Result(Timespec, Errno);

// The process ID reaped by waitpid and its raw wait status word.
pub comp WaitStatus := struct { pid: int32, status: int32 };
pub comp WaitResult := root::result::Result(WaitStatus, Errno);

// File metadata with the same fields and types as the Linux std::os::Stat,
// converted from darwin's struct stat.
pub comp Stat := struct {
    dev: uint64,
    ino: uint64,
    nlink: uint64,
    mode: uint32,
    uid: uint32,
    gid: uint32,
    pad0: int32,
    rdev: uint64,
    size: int64,
    blksize: int64,
    blocks: int64,
    atime: Timespec,
    mtime: Timespec,
    ctime: Timespec,
    reserved: [3]int64,
};
pub comp StatResult := root::result::Result(Stat, Errno);

// darwin's 64-bit-inode struct stat (144 bytes on arm64).
pub(root) comp DarwinStat := struct {
    dev: int32,
    mode: uint16,
    nlink: uint16,
    ino: uint64,
    uid: uint32,
    gid: uint32,
    rdev: int32,
    atime: Timespec,
    mtime: Timespec,
    ctime: Timespec,
    birthtime: Timespec,
    size: int64,
    blocks: int64,
    blksize: int32,
    flags: uint32,
    gen: uint32,
    lspare: int32,
    qspare: [2]int64,
};

// darwin struct utsname; each field is a NUL-terminated byte string.
pub comp Utsname := struct {
    sysname: [256]uint8,
    nodename: [256]uint8,
    release: [256]uint8,
    version: [256]uint8,
    machine: [256]uint8,
};
pub comp UtsnameResult := root::result::Result(Utsname, Errno);

// struct rlimit.
pub comp Rlimit := struct { current: uint64, maximum: uint64 };
pub comp RLIM_INFINITY: uint64 = 9223372036854775807;
pub comp RlimitResult := root::result::Result(Rlimit, Errno);

// struct iovec for readv/writev.
pub comp Iovec := struct { base: *uint8, len: usize };

// struct pollfd.
pub comp PollFd := struct { fd: int32, events: int16, revents: int16 };

// Standard descriptors.
pub comp stdin: int32 = 0;
pub comp stdout: int32 = 1;
pub comp stderr: int32 = 2;

// mmap/mprotect protection and mapping flags.
pub comp PROT_NONE: int32 = 0x0;
pub comp PROT_READ: int32 = 0x1;
