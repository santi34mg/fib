// Generic maps with caller-supplied equality and linear lookup, backed by the
// std::memory heap allocator. Copies share storage: treat each map as one owner
// and call deinit once. Byte-string keys can use std::string::eq.
pub comp fn Map(K: type, V: type) type {
    return struct { keys: []K, values: []V, len: usize, equal: fn(K, K) bool };
}

pub fn init(K: type, V: type, equal: fn(K, K) bool) Map(K, V) {
    comp M := Map(K, V);
    return M {
        keys: root::memory::slice_from_parts(null as *K, 0),
        values: root::memory::slice_from_parts(null as *V, 0), len: 0, equal: equal
    };
}

// Insert or replace. On allocation failure the map is unchanged.
pub fn insert(K: type, V: type, map: *Map(K, V), key: K, value: V) root::memory::Status {
    comp R := root::memory::Status;
    i: usize = 0;
    while (i < map.len) {
        if (map.equal)(map.keys[i], key) { map.values[i] = value; return R.Ok; };
        i = i + 1;
    };
    if map.len == map.keys.len {
        if map.len > 9223372036854775805 { return R.Err(root::memory::AllocError.NotEnoughMemory); };
        capacity := map.len * 2 + 4;
        keys: []K;
        switch (root::memory::alloc(K, capacity)) {
            when .Err(error) { return R.Err(error); }
            when .Ok(storage) { keys = storage; }
        };
        values: []V;
        switch (root::memory::alloc(V, capacity)) {
            when .Err(error) {
                root::memory::free(K, keys);
                return R.Err(error);
            }
            when .Ok(storage) { values = storage; }
        };
        i = 0;
        while (i < map.len) {
            keys[i] = map.keys[i];
            values[i] = map.values[i];
            i = i + 1;
        };
        // The previous arrays came from alloc (or are empty), so freeing them
        // cannot fail while the map is used through its single owner.
        root::memory::free(K, map.keys);
        root::memory::free(V, map.values);
        map.keys = keys;
        map.values = values;
    };
    map.keys[map.len] = key;
    map.values[map.len] = value;
    map.len = map.len + 1;
    return R.Ok;
}

// The value stored for key, or None. A present empty value is still Some.
pub fn get(K: type, V: type, map: Map(K, V), key: K) root::option::Option(V) {
    comp Lookup := root::option::Option(V);
    i: usize = 0;
    while (i < map.len) {
        if (map.equal)(map.keys[i], key) { return Lookup.Some(map.values[i]); };
        i = i + 1;
    };
    return Lookup.None;
}

// Free owned arrays and reset the map for reuse, preserving its equality.
pub fn deinit(K: type, V: type, map: *Map(K, V)) {
    root::memory::free(K, map.keys);
    root::memory::free(V, map.values);
    map* = init(K, V, map.equal);
}
