// The compiler injects the functions documented below into std::memory.
// Signatures are comments, not source declarations. T is inferred from the
// pointer or slice argument; do not pass it as a separate type argument.
// Calls and aliases retain compiler identities.
//
// pub fn unchecked_deref(pointer: *T) T
// pub fn unchecked_deref(pointer: const *T) T
// Access the pointed-to place without the usual null-pointer trap. The result
// can be assigned to or addressed; a readonly pointer yields a readonly place.
// The caller must supply live, aligned storage valid for the access. This does
// not allocate, copy the pointee, or extend its lifetime. *void is not supported.
// Example: std::memory::unchecked_deref(pointer) = value;
//
// pub fn slice_from_parts(pointer: *T, length: usize) []T
// pub fn slice_from_parts(pointer: const *T, length: usize) const []T
// Construct a view with length elements (not bytes), preserving readonly access.
// No allocation, copy, pointer dereference or backing-storage validation occurs.
// The caller maintains the storage's lifetime and sufficient capacity; later
// indexing checks the declared length, not the actual allocation. T cannot be
// void. A typed null pointer with length zero creates an empty slice:
// empty := std::memory::slice_from_parts(null as *uint8, 0);
//
// pub fn slice_data(slice: []T) *T
// pub fn slice_data(slice: const []T) const *T
// Return the backing pointer, preserving readonly access, without dereferencing
// it or changing the slice. The pointer borrows the same storage and lifetime.
// Empty slices may have null or non-null data; use .len to test for emptiness.
// Example: pointer := std::memory::slice_data(bytes);
// Sentinel slices preserve their terminator in the pointer result:
// slice_data(view: const [:0]uint8) returns const [*:0]uint8.
// slice_from_parts always produces an ordinary slice; arbitrary lengths do
// not establish a sentinel at the new endpoint. Use span below for C strings.

// ---- Allocation ----
//
// Every allocator is an Allocator value. Two implementations are provided:
// heap_allocator() (the free-list heap used by alloc/free) and
// page_allocator() (one private mmap per allocation). The typed helpers
// create/destroy work with any Allocator; alloc/free use the heap.

pub comp AllocError: type = enum {
    NotEnoughMemory,
    MapFailed,
    InvalidAlignment,
    UnmapFailed,
    // The pointer was not returned by this allocator or is already free.
    InvalidFree,
};

pub comp AllocResult := root::result::Result(*uint8, AllocError);
pub comp Status := root::result::Result(void, AllocError);

pub comp Allocator: type = struct {
    context: *void,
    // Allocate uninitialized storage of a nonzero size; alignment must be a
    // positive power of two supported by the implementation.
    alloc: fn(*void, usize, usize) AllocResult,
    // Free only the original live pointer returned by this allocator, or null.
    free: fn(*void, *uint8) Status,
};

// Alignment requested by the typed helpers. Supported Linux x86-64 types fit it.
comp TYPED_ALIGNMENT: usize = 16;

// Allocate count uninitialized elements of T from allocator. A zero count
// returns an empty slice without allocating; zero-sized element types still
// receive a live allocation. Size overflow returns NotEnoughMemory.
pub fn create(T: type, allocator: Allocator, count: usize) root::result::Result([]T, AllocError) {
    comp R := root::result::Result([]T, AllocError);
    empty: *T = null;
    if count == 0 { return R.Ok(root::memory::slice_from_parts(empty, 0)); };
    element := core::sizeof(T);
    limit: usize = 18446744073709551615;
    if element > limit / count { return R.Err(AllocError.NotEnoughMemory); };
    size := element * count;
    if size == 0 { size = 1; };
    switch (allocator.alloc(allocator.context, size, TYPED_ALIGNMENT)) {
        when .Err(error) { return R.Err(error); }
        when .Ok(pointer) {
            typed := root::os_abi::pointer_from_word(T, root::os_abi::pointer_to_word(pointer));
            return R.Ok(root::memory::slice_from_parts(typed, count));
        }
    };
}

// Release a slice returned by create with the same allocator; all views of it
// then expire. Empty slices own no storage and are ignored.
pub fn destroy(T: type, allocator: Allocator, items: []T) Status {
    if items.len == 0 { return Status.Ok; };
    pointer := root::os_abi::pointer_from_word(uint8,
        root::os_abi::pointer_to_word(root::memory::slice_data(items)));
    return allocator.free(allocator.context, pointer);
}

// create with the heap allocator.
pub fn alloc(T: type, count: usize) root::result::Result([]T, AllocError) {
    return create(T, heap_allocator(), count);
}

// destroy with the heap allocator. Pass the exact slice returned by alloc.
pub fn free(T: type, items: []T) Status {
    return destroy(T, heap_allocator(), items);
}

// ---- Page allocator ----

// Stateless Linux mmap allocator; context is ignored. Zero size and size/padding
// overflow return NotEnoughMemory. Any power-of-two alignment is supported.
// Unknown pointers and double frees are undefined: the header is trusted.
pub fn page_allocator() Allocator {
    return Allocator {
        context: null,
        alloc: page_alloc,
        free: page_free,
    };
}

// An explicit struct, rather than a byte slice, makes the mapping metadata's intent clear.
// Pointer and usize fields give this header 8-byte alignment on Linux x86-64.
comp PageHeader: type = struct {
    base: *uint8,
    length: usize,
};

fn page_alloc(context: *void, size: usize, align: usize) AllocResult {
    if align == 0 { return AllocResult.Err(AllocError.InvalidAlignment); };
    if (align & (align - 1)) != 0 { return AllocResult.Err(AllocError.InvalidAlignment); };
    if size == 0 { return AllocResult.Err(AllocError.NotEnoughMemory); };
    alignment := align;
    if alignment < 8 { alignment = 8; };
    header := core::sizeof(PageHeader);
    limit: usize = 18446744073709551615;
    padding := alignment - 1;
    if header > limit - padding { return AllocResult.Err(AllocError.NotEnoughMemory); };
    overhead := header + padding;
    if size > limit - overhead { return AllocResult.Err(AllocError.NotEnoughMemory); };
    length := size + overhead;
    switch (root::os::mmap(
        null,
        length,
        root::os::PROT_READ | root::os::PROT_WRITE,
        root::os::MAP_PRIVATE | root::os::MAP_ANONYMOUS,
        -1,
        0
    )) {
        when .Ok(ptr) {
            // A successful mapping contains length bytes, so these addresses
            // cannot wrap. Round within the reserved worst-case padding.
            start := root::os_abi::pointer_to_word(ptr) + (header as uint64);
            extra := ((alignment as uint64) - start % (alignment as uint64)) % (alignment as uint64);
            aligned := start + extra;
            metadata := root::os_abi::pointer_from_word(PageHeader, aligned - (header as uint64));
            metadata* = PageHeader { base: ptr, length: length };
            return AllocResult.Ok(root::os_abi::pointer_from_word(uint8, aligned));
        }
        when .Err(err) {
            if err == root::os::ENOMEM { return AllocResult.Err(AllocError.NotEnoughMemory); };
            return AllocResult.Err(AllocError.MapFailed);
        }
    };
}

fn page_free(context: *void, ptr: *uint8) Status {
    if ptr == null { return Status.Ok; };
    metadata := root::os_abi::pointer_from_word(PageHeader,
        root::os_abi::pointer_to_word(ptr) - (core::sizeof(PageHeader) as uint64));
    // Copy before unmapping; do not mutate the header, including on failure.
    mapping := metadata*;
    switch (root::os::munmap(mapping.base, mapping.length)) {
        when .Ok { return Status.Ok; }
        when .Err(err) { return Status.Err(AllocError.UnmapFailed); }
    };
}

// ---- Heap allocator ----

// Single-threaded first-fit free list; context is ignored. Fresh storage comes
// from os::heap_grow (the program break on Linux, private mappings on macOS).
// Alignment up to 16 is supported; larger values return InvalidAlignment.
// Freed storage is reused and adjacent free blocks coalesce, but memory is
// never returned to the OS. Freeing an unknown or already-free pointer returns
// InvalidFree and leaves the heap unchanged. On Linux, do not shrink the break
// over live heap storage.
pub fn heap_allocator() Allocator {
    return Allocator {
        context: null,
        alloc: heap_alloc,
        free: heap_free,
    };
}

comp Block := struct {
    size: usize,
    next: *Block,
    is_free: bool,
};

head: *Block = null;

fn header_size() usize {
    return ((core::sizeof(Block) + 15) / 16) * 16;
}

fn address(pointer: *Block) uint64 {
    return root::os_abi::pointer_to_word(pointer);
}

fn block_at(word: uint64) *Block {
    return root::os_abi::pointer_from_word(Block, word);
}

fn data(block: *Block) *uint8 {
    return root::os_abi::pointer_from_word(uint8, address(block) + (header_size() as uint64));
}

fn find_free_block(size: usize) *Block {
    current := head;
    while (current != null) {
        if (current*).is_free && (current*).size >= size { return current; };
        current = (current*).next;
    };
    return null;
}

// Fresh storage comes from os::heap_grow: the program break on Linux, private
// anonymous mappings on macOS. Both return 16-byte-aligned regions.
fn request_memory(size: usize) *Block {
    header := header_size();
    if size > 9223372036854775807 - header - 15 { return null; };
    switch (root::os::heap_grow(size + header)) {
        when .Err(error) { return null; }
        when .Ok(pointer) {
            block := block_at(root::os_abi::pointer_to_word(pointer));
            block* = Block { size: size, next: null, is_free: true };
            if head == null {
                head = block;
            } else {
                tail := head;
                while ((tail*).next != null) { tail = (tail*).next; };
                (tail*).next = block;
            };
            return block;
        }
    };
}

fn split(block: *Block, size: usize) {
    header := header_size();
    if (block*).size - size >= header + 16 {
        remainder := block_at(address(block) + ((header + size) as uint64));
        remainder* = Block {
            size: (block*).size - size - header,
            next: (block*).next,
            is_free: true
        };
        (block*).next = remainder;
        (block*).size = size;
    };
    (block*).is_free = false;
}

fn heap_alloc(context: *void, size: usize, align: usize) AllocResult {
    if align == 0 || (align & (align - 1)) != 0 || align > 16 {
        return AllocResult.Err(AllocError.InvalidAlignment);
    };
    if size == 0 { return AllocResult.Err(AllocError.NotEnoughMemory); };
    // Keep sizes within a signed break increment after rounding and headers.
    if size > 9223372036854775807 - 15 { return AllocResult.Err(AllocError.NotEnoughMemory); };
    rounded := ((size + 15) / 16) * 16;
    block := find_free_block(rounded);
    if block == null { block = request_memory(rounded); };
    if block == null { return AllocResult.Err(AllocError.NotEnoughMemory); };
    split(block, rounded);
    return AllocResult.Ok(data(block));
}

fn heap_free(context: *void, ptr: *uint8) Status {
    if ptr == null { return Status.Ok; };
    target := root::os_abi::pointer_to_word(ptr);
    current := head;
    while (current != null) {
        if root::os_abi::pointer_to_word(data(current)) == target {
            if (current*).is_free { return Status.Err(AllocError.InvalidFree); };
            (current*).is_free = true;
            // Regions need not be adjacent: another break user or separate
            // mappings can leave gaps, so only touching blocks merge.
            block := head;
            while (block != null) {
                next := (block*).next;
                if next != null && (block*).is_free && (next*).is_free &&
                    address(block) + ((header_size() + (block*).size) as uint64) == address(next) {
                    (block*).size = (block*).size + header_size() + (next*).size;
                    (block*).next = (next*).next;
                } else {
                    block = next;
                };
            };
            return Status.Ok;
        };
        current = (current*).next;
    };
    return Status.Err(AllocError.InvalidFree);
}

// ---- Byte operations and C strings ----

// Fill every byte in destination. Empty slices do not access storage.
pub fn memset(destination: []uint8, value: uint8) {
    i: usize = 0;
    while (i < destination.len) {
        destination[i] = value;
        i = i + 1;
    };
}

// Copy source bytes into destination's prefix; the remaining bytes are unchanged.
// A short destination traps before any write. The regions must not overlap.
pub fn memcpy(destination: []uint8, source: const []uint8) {
    target := destination[..source.len];
    i: usize = 0;
    while (i < source.len) {
        target[i] = source[i];
        i = i + 1;
    };
}

// View a NUL-terminated C string as a terminated slice, excluding the NUL.
// Scans for the terminator; no allocation or copy. The view borrows the
// pointer's storage and lifetime.
pub fn span(pointer: const [*:0]uint8) const [:0]uint8 {
    return c_string_at(root::os_abi::pointer_to_word(pointer));
}

// span for a raw address, e.g. host argv/envp entries. The caller guarantees
// live NUL-terminated storage at start.
pub(root) fn c_string_at(start: uint64) const [:0]uint8 {
    length: usize = 0;
    while (true) {
        byte := root::os_abi::pointer_from_word(uint8, start + (length as uint64));
        if (byte*) == 0 { break; };
        length = length + 1;
    };
    return root::os_abi::terminated_from_parts(
        root::os_abi::pointer_from_word(uint8, start), length);
}
