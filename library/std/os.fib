// Linux x86-64 implementation.
//
// The compiler injects syscall0 through syscall6 into std::os. The signatures
// below are documentation, not source declarations. Each argument a1 through
// a6 accepts either a uint64 word or a typed pointer, including readonly pointers;
// the uint64 forms shown here also describe the register representation.
// Typed numeric values require explicit conversion to uint64. The syscall
// number must be uint64; integer literals receive that context automatically.
//
// pub fn syscall0(number: uint64) int64
// Invoke a raw syscall without arguments, e.g. std::os::syscall0(39) for getpid.
//
// pub fn syscall1(number: uint64, a1: uint64) int64
// Invoke a raw syscall with one argument, e.g. std::os::syscall1(3, 1) for close.
//
// pub fn syscall2(number: uint64, a1: uint64, a2: uint64) int64
// Invoke a raw syscall with two arguments, e.g. munmap's address and byte length.
//
// pub fn syscall3(number: uint64, a1: uint64, a2: uint64, a3: uint64) int64
// Invoke a raw syscall with three arguments, e.g. write's fd, pointer and length.
//
// pub fn syscall4(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64) int64
// Invoke a raw syscall with four arguments, e.g. openat's dirfd, path, flags, mode.
//
// pub fn syscall5(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64) int64
// Invoke a raw syscall with five arguments in Linux x86-64 register order.
//
// pub fn syscall6(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64, a6: uint64) int64
// Invoke a raw syscall with six arguments, e.g. mmap's complete argument list.
//
// All forms return the raw signed kernel result. They do not translate errors
// into Result, retry interrupted operations, or complete short reads/writes.
// Most Linux syscalls encode errno as -1 through -4095; brk is an exception
// handled by sbrk below. Callers supply syscall-specific valid pointer regions,
// lengths, permissions and lifetimes. Calls use inline assembly with memory
// clobbers; no libc wrapper is involved. Other targets and execution in build
// files are not supported. Prefer the typed wrappers below when available.

comp Result := root::result::Result;
// Type annotations name aliases; computed types are instantiated in comp bindings.
pub comp CountResult := Result(usize, int32);
pub comp IntResult := Result(int32, int32);
pub comp MappingResult := Result(*uint8, int32);
pub comp Status := enum { Ok, Err: int32 };


pub const stdout := 1;
// TODO: i think its 2 but have to check
pub const stderr := 2;

fn failed(value: int64) bool {
    return value < 0 && value >= -4095;
}

pub fn read(fd: int32, buffer: uint8[]) CountResult {
    comp R := Result(usize, int32);
    value := root::os::syscall3(0, (fd as int64) as uint64,
        root::memory::slice_data(buffer), buffer.len as uint64);
    if failed(value) { return R.Err((-value) as int32); };
    return R.Ok(value as usize);
}

pub fn write(fd: int32, buffer: const uint8[]) CountResult {
    comp R := Result(usize, int32);
    value := root::os::syscall3(1, (fd as int64) as uint64,
        root::memory::slice_data(buffer), buffer.len as uint64);
    if failed(value) { return R.Err((-value) as int32); };
    return R.Ok(value as usize);
}

pub fn close(fd: int32) Status {
    value := root::os::syscall1(3, (fd as int64) as uint64);
    if failed(value) { return Status.Err((-value) as int32); };
    return Status.Ok;
}

pub fn getpid() IntResult {
    comp R := Result(int32, int32);
    value := root::os::syscall0(39);
    if failed(value) { return R.Err((-value) as int32); };
    return R.Ok(value as int32);
}

// Path must reference live NUL-terminated storage, e.g. c"/dev/null".
pub fn openat(dirfd: int32, path: const *uint8, flags: int32, mode: uint32) IntResult {
    comp R := Result(int32, int32);
    value := root::os::syscall4(257, (dirfd as int64) as uint64, path,
        (flags as int64) as uint64, mode as uint64);
    if failed(value) { return R.Err((-value) as int32); };
    return R.Ok(value as int32);
}

pub fn mmap(address: *uint8, length: usize, protection: int32, flags: int32, fd: int32, offset: int64) MappingResult {
    comp R := Result(*uint8, int32);
    value := root::os::syscall6(9, address, length as uint64,
        (protection as int64) as uint64, (flags as int64) as uint64,
        (fd as int64) as uint64, offset as uint64);
    if failed(value) { return R.Err((-value) as int32); };
    return R.Ok(root::os_abi::pointer_from_word(uint8, value as uint64));
}

pub fn munmap(address: *uint8, length: usize) Status {
    value := root::os::syscall2(11, address, length as uint64);
    if failed(value) { return Status.Err((-value) as int32); };
    return Status.Ok;
}


pub fn get_page_size() usize {
    return 4096;
}

// Linux brk returns the resulting break, including the unchanged break on failure.
// Query on every call so this wrapper does not retain a stale cached break.
pub fn sbrk(increment: int64) MappingResult {
    current := root::os::syscall1(12, 0) as uint64;
    if current == 0 { return MappingResult.Err(12); };
    requested := current;
    if increment > 0 {
        amount := increment as uint64;
        if amount > 18446744073709551615 - current { return MappingResult.Err(12); };
        requested = current + amount;
    } else {
        // This also handles INT64_MIN without signed negation overflow.
        amount := ((-(increment + 1)) as uint64) + 1;
        if increment == 0 { amount = 0; };
        if amount >= current { return MappingResult.Err(12); };
        requested = current - amount;
    };
    if increment != 0 {
        actual := root::os::syscall1(12, requested) as uint64;
        if actual != requested { return MappingResult.Err(12); };
    };
    return MappingResult.Ok(root::os_abi::pointer_from_word(uint8, current));
}
