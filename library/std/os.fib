// Linux x86-64 implementation.
//
// The compiler injects syscall0 through syscall6 into std::os. The signatures
// below are documentation, not source declarations. Each argument a1 through
// a6 accepts either a uint64 word or a typed pointer, including readonly pointers;
// the uint64 forms shown here also describe the register representation.
// Typed numeric values require explicit conversion to uint64. The syscall
// number must be uint64; integer literals receive that context automatically.
// std::syscall names every Linux x86-64 syscall number, e.g. std::syscall::GETPID.
//
// pub fn syscall0(number: uint64) int64
// Invoke a raw syscall without arguments, e.g. std::os::syscall0(39) for getpid.
//
// pub fn syscall1(number: uint64, a1: uint64) int64
// Invoke a raw syscall with one argument, e.g. std::os::syscall1(3, 1) for close.
//
// pub fn syscall2(number: uint64, a1: uint64, a2: uint64) int64
// Invoke a raw syscall with two arguments, e.g. munmap's address and byte length.
//
// pub fn syscall3(number: uint64, a1: uint64, a2: uint64, a3: uint64) int64
// Invoke a raw syscall with three arguments, e.g. write's fd, pointer and length.
//
// pub fn syscall4(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64) int64
// Invoke a raw syscall with four arguments, e.g. openat's dirfd, path, flags, mode.
//
// pub fn syscall5(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64) int64
// Invoke a raw syscall with five arguments in Linux x86-64 register order.
//
// pub fn syscall6(number: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64, a6: uint64) int64
// Invoke a raw syscall with six arguments, e.g. mmap's complete argument list.
//
// All forms return the raw signed kernel result. They do not translate errors
// into Result, retry interrupted operations, or complete short reads/writes.
// Most Linux syscalls encode errno as -1 through -4095; brk is an exception
// handled by sbrk below. Callers supply syscall-specific valid pointer regions,
// lengths, permissions and lifetimes. Calls use inline assembly with memory
// clobbers; no libc wrapper is involved. Other targets and execution in build
// files are not supported. Prefer the typed wrappers below when available.
//
// Typed wrappers return a Result whose Err variant carries an Errno (the
// positive kernel error number; see the E* constants and errno_name). Like the
// raw forms, they never retry EINTR or complete short transfers; use
// std::io::read_full and std::io::write_all for that. Path arguments must reference live
// NUL-terminated storage, e.g. c"/tmp" or a std::process::Arguments element.
// Out-pointer arguments must reference live writable storage.

// Positive Linux error number. An alias of int32, so values compare directly
// with the E* constants: `if error == std::os::ENOENT { ... }`.
pub comp Errno := int32;

// Type annotations name aliases; computed types are instantiated in comp bindings.
pub comp CountResult := root::result::Result(usize, Errno);
pub comp IntResult := root::result::Result(int32, Errno);
pub comp OffsetResult := root::result::Result(int64, Errno);
pub comp MappingResult := root::result::Result(*uint8, Errno);
pub comp Status := root::result::Result(void, Errno);

// Two descriptors. For pipes, first is the read end and second the write end.
pub comp FdPair := struct { first: int32, second: int32 };
pub comp FdPairResult := root::result::Result(FdPair, Errno);

// struct timespec.
pub comp Timespec := struct { seconds: int64, nanoseconds: int64 };
pub comp TimeResult := root::result::Result(Timespec, Errno);

// The process ID reaped by waitpid and its raw wait status word.
pub comp WaitStatus := struct { pid: int32, status: int32 };
pub comp WaitResult := root::result::Result(WaitStatus, Errno);

// struct stat as laid out by the x86-64 kernel (144 bytes).
pub comp Stat := struct {
    dev: uint64,
    ino: uint64,
    nlink: uint64,
    mode: uint32,
    uid: uint32,
    gid: uint32,
    pad0: int32,
    rdev: uint64,
    size: int64,
    blksize: int64,
    blocks: int64,
    atime: Timespec,
    mtime: Timespec,
    ctime: Timespec,
    reserved: [3]int64,
};
pub comp StatResult := root::result::Result(Stat, Errno);

// struct utsname; each field is a NUL-terminated byte string.
pub comp Utsname := struct {
    sysname: [65]uint8,
    nodename: [65]uint8,
    release: [65]uint8,
    version: [65]uint8,
    machine: [65]uint8,
    domainname: [65]uint8,
};
pub comp UtsnameResult := root::result::Result(Utsname, Errno);

// struct rlimit; RLIM_INFINITY is all bits set.
pub comp Rlimit := struct { current: uint64, maximum: uint64 };
pub comp RLIM_INFINITY: uint64 = 18446744073709551615;
pub comp RlimitResult := root::result::Result(Rlimit, Errno);

// struct iovec for readv/writev.
pub comp Iovec := struct { base: *uint8, len: usize };

// struct pollfd.
pub comp PollFd := struct { fd: int32, events: int16, revents: int16 };

