// OS-backed randomness for Linux x86-64. No userspace generator state.
pub comp Error := enum { Io: root::os::Errno, InvalidBound };
pub comp Status := root::result::Result(void, Error);
pub comp Uint64Result := root::result::Result(uint64, Error);

// getrandom with flags=0 waits for the kernel RNG to initialize. The context
// is unused.
fn kernel_read(context: *void, buffer: []uint8) root::os::CountResult {
    return root::os::getrandom(buffer, 0);
}

// Fill the entire slice, retrying interruptions and short reads. An error may
// leave a partially filled buffer; zero progress reports EIO. Empty slices do
// not issue a syscall.
pub fn fill(buffer: []uint8) Status {
    source := root::io::Reader { context: null, read: kernel_read };
    switch (root::io::read_full(source, buffer)) {
        when .Err(error) { return Status.Err(Error.Io(error)); }
        when .Ok(count) {
            if count != buffer.len { return Status.Err(Error.Io(root::os::EIO)); };
        }
    };
    return Status.Ok;
}

// Decode bytes explicitly so the numeric API does not depend on host byte order.
pub fn random_uint64() Uint64Result {
    bytes: [8]uint8 = [0, 0, 0, 0, 0, 0, 0, 0];
    switch (fill(bytes)) {
        when .Err(error) { return Uint64Result.Err(error); }
        when .Ok {}
    };
    value: uint64 = 0;
    i: usize = 0;
    while (i < bytes.len) {
        value = (value << 8) | (bytes[i] as uint64);
        i = i + 1;
    };
    return Uint64Result.Ok(value);
}

// Uniform in [0, upper). Rejection sampling avoids modulo bias. A zero bound
// is rejected without requesting entropy; one always returns zero.
pub fn below(upper: uint64) Uint64Result {
    if upper == 0 { return Uint64Result.Err(Error.InvalidBound); };
    if upper == 1 { return Uint64Result.Ok(0); };
    threshold := ((0 as uint64) - upper) % upper;
    while (true) {
        switch (random_uint64()) {
            when .Err(error) { return Uint64Result.Err(error); }
            when .Ok(value) {
                if value >= threshold { return Uint64Result.Ok(value % upper); };
            }
        };
    };
}
