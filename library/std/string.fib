// Byte-string helpers. Lengths count bytes; no encoding is assumed. Ordinary
// byte strings are `const []uint8`; NUL-terminated strings (process arguments,
// environment values, c"..." views) are `const [:0]uint8` and convert to
// `const []uint8` implicitly, so every helper here accepts both.
pub comp Error := enum { BufferTooSmall };
pub comp ConcatResult := root::result::Result([]uint8, Error);

// Borrow caller-owned storage without allocation or lifetime extension. Sources
// must not overlap destination. Failure leaves destination unchanged; success
// preserves its unused tail and appends no NUL. Check capacity without adding
// input lengths first, so even oversized lengths cannot wrap the check.
pub fn concat(destination: []uint8, a: const []uint8, b: const []uint8) ConcatResult {
    if a.len > destination.len { return ConcatResult.Err(Error.BufferTooSmall); };
    if b.len > destination.len - a.len { return ConcatResult.Err(Error.BufferTooSmall); };
    root::memory::memcpy(destination, a);
    root::memory::memcpy(destination[a.len..], b);
    return ConcatResult.Ok(destination[..a.len + b.len]);
}

// Bytewise, case-sensitive content equality, including empty slices; no
// allocation. Usable directly as a std::map equality function.
pub fn eq(a: const []uint8, b: const []uint8) bool {
    if a.len != b.len { return false; };
    i: usize = 0;
    while (i < a.len) {
        if a[i] != b[i] { return false; };
        i += 1;
    };
    return true;
}

// Index of the first occurrence of byte, if any.
pub fn index_of(value: const []uint8, byte: uint8) root::option::Option(usize) {
    comp O := root::option::Option(usize);
    i: usize = 0;
    while (i < value.len) {
        if value[i] == byte { return O.Some(i); };
        i += 1;
    };
    return O.None;
}
