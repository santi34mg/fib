{
  "name": "fib-lsp-vscode",
  "displayName": "Fib Language Support",
  "description": "Semantic syntax highlighting for Fib, backed by fib-lsp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/santi34mg/fib.git",
    "directory": "lsp/editors/vscode"
  },
  "activationEvents": ["onLanguage:fib"],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fib",
        "extensions": [".fib"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Fib",
      "properties": {
        "fib.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the fib-lsp entry point (server.js) or the fib-lsp binary. Leave empty to use the copy bundled with this extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/copy-server.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
