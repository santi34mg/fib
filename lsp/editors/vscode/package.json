{
  "name": "fib-lsp-vscode",
  "displayName": "Fib Language Support",
  "description": "Compiler-backed highlighting and diagnostics for Fib",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/santi34mg/fib.git",
    "directory": "lsp/editors/vscode"
  },
  "activationEvents": [
    "onLanguage:fib"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fib",
        "extensions": [
          ".fib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Fib",
      "properties": {
        "fib.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the native fib-lsp executable. Leave empty to use fib-lsp from PATH. Install it with cargo install --path /path/to/fib --no-default-features --bin fib-lsp."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "scripts": {
    "test": "node --test"
  }
}
