comp memory := std::memory;
comp Pair := struct { first: uint64, second: uint64 };
comp Empty := struct {};
comp View := struct { bytes: const []uint8 };

// alloc returns a Result; expect aborts with a message on failure.
fn take(T: type, count: usize) []T {
    return std::result::expect([]T, memory::AllocError, memory::alloc(T, count), "out of memory");
}

fn released(T: type, items: []T) bool {
    return std::result::is_ok(void, memory::AllocError, memory::free(T, items));
}

fn main() int32 {
    numbers := take(int32, 8);
    if numbers.len != 8 { return 1; };
    i: usize = 0;
    while (i < numbers.len) {
        numbers[i] = i as int32;
        i = i + 1;
    };
    pairs := take(Pair, 2);
    if pairs.len != 2 { return 2; };
    pairs[0] = Pair { first: 20, second: 22 };
    if pairs[0].first + pairs[0].second != 42 || numbers[7] != 7 { return 3; };
    original := memory::slice_data(numbers);
    if !released(int32, numbers) { return 10; };
    reused := take(int32, 8);
    if reused.len != 8 || memory::slice_data(reused) != original { return 4; };
    reused[0] = 42;
    if reused[0] != 42 { return 5; };
    if !released(int32, reused) || !released(Pair, pairs) { return 11; };
    empty := take(Empty, 3);
    if empty.len != 3 { return 6; };
    empty[2] = Empty {};
    if !released(Empty, empty) { return 12; };
    zero := take(int32, 0);
    if zero.len != 0 { return 7; };
    if !released(int32, zero) { return 13; };
    views := take(View, 1);
    if views.len != 1 { return 8; };
    views[0] = View { bytes: "hello" };
    if views[0].bytes[0] != 'h' { return 9; };
    if !released(View, views) { return 14; };
    return 42;
}
