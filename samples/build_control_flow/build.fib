// Interpreter fixture; the acceptance test supplies main.fib beside this file.
fn output_name(count: int32) const []uint8 {
    if (count == 3) { return "app"[..]; };
    return "fallback"[..];
}

fn build() int32 {
    count := 0;
    while (count < 3) {
        count = count + 1;
        if (count == 1) {
            build_api::add_source("main.fib"[..]);
        };
    };
    build_api::set_entry("main"[..]);
    build_api::set_output(output_name(count));
    return 0;
}
