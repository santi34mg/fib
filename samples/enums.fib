// Plain enum values and exhaustive matching. Prints green.

comp Color: type = enum {
    Red,
    Green,
    Blue,
};

fn main() int32 {
    c: Color = Color.Green;
    switch (c) {
        when .Red { std::io::print("red\n"); }
        when .Green { std::io::print("green\n"); }
        when .Blue { std::io::print("blue\n"); }
    };
    return 0;
}
