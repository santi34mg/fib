// Naive recursive fib(50) benchmark.
// Compile-only in e2e: takes hours to run, so no expected output is pinned.
import std::libc

fn fib(n: @int4) @int4;

fn fib(n: @int4) @int4 {
    if n <= 1 {
        return n;
    };
    return fib(n - 1) + fib(n - 2);
}

fn main() @int4 {
    libc::printf("Fibonacci benchmark (recursive, no memoization)\n");
    libc::printf("-----------------------------------------------\n");
    i: @int4 = 0;
    while (i <= 50) {
        result: @int4 = fib(i);
        libc::printf("fib(%d) = %d\n", i, result);
        i += 1;
    };
    return 0;
}
