// Naive recursive Fibonacci benchmark. Defaults to fib(20) for a quick run.
// Increase the limit to 50 for a slow benchmark; int64 holds fib(50).

fn fib(n: int32) int64 {
    if n <= 1 {
        return n as int64;
    };
    return fib(n - 1) + fib(n - 2);
}

fn main() int32 {
    std::io::print("Fibonacci benchmark (recursive, no memoization)\n");
    std::io::print("-----------------------------------------------\n");
    i: int32 = 0;
    while (i <= 20) {
        result: int64 = fib(i);
        args: [2]std::io::Arg = [std::io::Arg.Signed(i as int64), std::io::Arg.Signed(result)];
        std::io::printf("fib({}) = {}\n", args[..]);
        i += 1;
    };
    return 0;
}
