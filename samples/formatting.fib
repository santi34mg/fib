comp io := std::io;

fn main() int32 {
    args: [4]std::formatting::Arg = [
        std::formatting::Arg.Bytes("Alice"),
        std::formatting::Arg.Signed(-42),
        std::formatting::Arg.Unsigned(18446744073709551615),
        std::formatting::Arg.Boolean(true)
    ];
    switch (io::printf("Hello {}, score: {}, max: {}, active: {} {{ok}}\n", args[..])) {
        when .Ok(count) { return 0; }
        when .Err(error) { return 1; }
    };
}
