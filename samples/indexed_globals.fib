// File-level storage has compile-time initial data; this table is writable.
table: int32[3] = [10, 20, 0];
tail := table[1..];
total := 0;

fn fill(items: int32[]) {
    items[1] = 12;
}

fn main() int32 {
    fill(tail);
    index := 0;
    while (index < 3) {
        total = total + table[index];
        index = index + 1;
    };
    return total; // 42
}
