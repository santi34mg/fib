// Heap linked list via malloc/free with defer cleanup.
// Intended output (unverified; analysis and execution are unfinished):
//   List:   10 -> 20 -> 30 -> null
//   Length: 3

type Node struct {
    data: int32,
    next: *Node,
}

fn push(head: *Node, val: int32) *Node {
    node: *Node = libc::malloc(16 as uint64) as *Node;
    node[0] = Node { data: val, next: head };
    return node;
}

fn list_length(head: *Node) int32 {
    count: int32 = 0;
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        count += 1;
        cur = (cur*).next;
    };
    return count;
}

fn print_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        libc::printf("%d -> ", (cur*).data);
        cur = (cur*).next;
    };
    libc::printf("null\n");
}

fn free_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        next: *Node = (cur*).next;
        libc::free(cur as *void);
        cur = next;
    };
}

fn main() int32 {
    head: *Node = null;

    head = push(head, 30);
    head = push(head, 20);
    head = push(head, 10);
    defer free_list(head);

    libc::printf("List:   ");
    print_list(head);
    libc::printf("Length: %d\n", list_length(head));

    return 0;
}
