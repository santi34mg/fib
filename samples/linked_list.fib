// Heap linked list via malloc/free with defer cleanup.
// Intended output (unverified; analysis and execution are unfinished):
//   List:   10 -> 20 -> 30 -> null
//   Length: 3

comp Node: type = struct {
    data: int32,
    next: *Node,
};

fn push(head: *Node, val: int32) *Node {
    node: *Node = std::memory::alloc(Node, 1);
    node[0] = Node { data: val, next: head };
    return node;
}

fn list_length(head: *Node) int32 {
    count: int32 = 0;
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        count += 1;
        cur = (cur*).next;
    };
    return count;
}

fn print_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        std::io::printf("%d -> "[..], (cur*).data);
        cur = (cur*).next;
    };
    std::io::printf("null\n"[..]);
}

fn free_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        next: *Node = (cur*).next;
        std::memory::free(Node, cur);
        cur = next;
    };
}

fn main() int32 {
    head: *Node = null;

    head = push(head, 30);
    head = push(head, 20);
    head = push(head, 10);
    defer free_list(head);

    std::io::printf("List:   "[..]);
    print_list(head);
    std::io::printf("Length: %d\n"[..], list_length(head));

    return 0;
}
