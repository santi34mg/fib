// Heap linked list via std allocation with defer cleanup.
// Expected output:
//   List:   10 -> 20 -> 30 -> null
//   Length: 3

comp Node: type = struct {
    data: int32,
    next: *Node,
};

fn push(head: *Node, val: int32) *Node {
    node := std::memory::alloc(Node, 1);
    if node.len == 0 { return head; };
    node[0] = Node { data: val, next: head };
    return std::memory::slice_data(node);
}

fn list_length(head: *Node) int32 {
    count: int32 = 0;
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        count += 1;
        cur = (cur*).next;
    };
    return count;
}

fn print_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        args: std::io::Arg[1] = [std::io::Arg.Signed((cur*).data as int64)];
        std::io::printf("{} -> ", args[..]);
        cur = (cur*).next;
    };
    std::io::print("null\n");
}

fn free_list(head: *Node) void {
    cur: *Node = head;
    while (true) {
        if cur == null {
            break;
        };
        next: *Node = (cur*).next;
        std::memory::free(Node, cur);
        cur = next;
    };
}

fn main() int32 {
    head: *Node = null;

    head = push(head, 30);
    head = push(head, 20);
    head = push(head, 10);
    defer free_list(head);

    std::io::print("List:   ");
    print_list(head);
    args: std::io::Arg[1] = [std::io::Arg.Signed(list_length(head) as int64)];
    std::io::printf("Length: {}\n", args[..]);

    return 0;
}
