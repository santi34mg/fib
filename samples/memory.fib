comp mem := std::memory;

fn main() int32 {
    bytes: uint8[6] = [1, 2, 3, 4, 5, 6];
    mem::memset(bytes[1..5], 255);
    if bytes[0] != 1 || bytes[1] != 255 || bytes[4] != 255 || bytes[5] != 6 { return 1; };
    mem::memcpy(bytes[2..], "hi");
    if bytes[1] != 255 || bytes[2] != 104 || bytes[3] != 105 || bytes[4] != 255 { return 2; };
    source: uint8[2] = [0, 128];
    mem::memcpy(bytes[..2], source[..]);
    if bytes[0] != 0 || bytes[1] != 128 { return 3; };
    empty: *uint8 = null;
    view := mem::slice_from_parts(empty, 0);
    mem::memset(view, 42);
    mem::memcpy(view, view);
    mem::memcpy(bytes[..], view);
    if bytes[0] != 0 || bytes[5] != 6 { return 4; };
    return 42;
}
