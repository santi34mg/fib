// Return two named values in a struct: divmod(17, 5).
// Tuple returns are analyzed but do not yet lower to native code.
// Expected output:
//   q=3 r=2

comp DivMod := struct { quotient: int32, remainder: int32 };

fn divmod(a: int32, b: int32) DivMod {
    return DivMod { quotient: a / b, remainder: a % b };
}

fn main() int32 {
    result := divmod(17, 5);
    q, r := result.quotient, result.remainder;
    args: [2]std::io::Arg = [std::io::Arg.Signed(q as int64), std::io::Arg.Signed(r as int64)];
    std::io::printf("q={} r={}\n", args[..]);
    return 0;
}
