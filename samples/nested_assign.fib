// Nested struct field assignment.
// Intended output (unverified; compiler pipeline unfinished):
//   got 42

type Inner struct {
    value: uint64,
}

type Outer struct {
    inner: Inner,
}

fn main() int32 {
    o: Outer = Outer { inner: Inner { value: 0 } };
    o.inner.value = 42;
    libc::printf("got %d\n", o.inner.value);
    return 0;
}
