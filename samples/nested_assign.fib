// Nested struct field assignment.
// Expected output:
//   got 42

comp Inner: type = struct {
    value: uint64,
};

comp Outer: type = struct {
    inner: Inner,
};

fn main() int32 {
    o: Outer = Outer { inner: Inner { value: 0 } };
    o.inner.value = 42;
    args: std::io::Arg[1] = [std::io::Arg.Unsigned(o.inner.value)];
    std::io::printf("got {}\n", args[..]);
    return 0;
}
