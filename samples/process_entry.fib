fn main(args: std::process::Arguments, env: std::process::Environment) std::result::Result(int32, void) {
    // args[0] is the executable name. Arguments and environment values are
    // NUL-terminated (const [:0]uint8); .len excludes the terminator.
    switch (std::process::getenv(env, "FIB_EXIT")) {
        when .Some(value) {
            if std::string::eq(value, "42") {
                return std::result::Result(int32, void).Ok(42);
            };
        }
        when .None {}
    };
    if args.len > 1 { return std::result::Result(int32, void).Ok(0); };
    return std::result::Result(int32, void).Err;
}
