// Slices (`T[]`) as intended `(ptr, len)` views over arrays.
// Intended output (unverified; analysis and execution are unfinished):
//   len=4 sum=100 s0=10
//   after s1=99 arr1=99

fn sum(s: int32[]) int32 {
    total: int32 = 0;
    i: int32 = 0;
    while (i < s.len as int32) {
        total += s[i];
        i += 1;
    };
    return total;
}

fn main() int32 {
    arr: int32[4] = [10, 20, 30, 40];
    s: int32[] = arr[0..4];
    libc::printf("len=%d sum=%d s0=%d\n", s.len as int32, sum(s), s[0]);
    s[1] = 99;
    libc::printf("after s1=%d arr1=%d\n", s[1], arr[1]);
    return 0;
}
