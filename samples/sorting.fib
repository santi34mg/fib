// Generic insertion sort over [8]int32.
// Expected output:
//   [ 1  2  3  5  6  7  8  10 ]

fn insertion_sort(T: type, arr: []T) void {
    i := 0;
    while (i < arr.len as int32) {
        j := i;
        while (j > 0) {
            if arr[j] < arr[j - 1] {
                t: T = arr[j];
                arr[j] = arr[j - 1];
                arr[j - 1] = t;
            };
            j -= 1;
        };
        i += 1;
    };
}

fn print_arr(arr: const []int32) void {
    std::io::print("[");
    i := 0;
    while (i < arr.len as int32) {
        args: [1]std::io::Arg = [std::io::Arg.Signed(arr[i] as int64)];
        std::io::printf(" {} ", args[..]);
        i += 1;
    };
    std::io::print("]\n");
}

fn main() int32 {
    arr: [8]int32 = [3, 8, 5, 10, 2, 1, 6, 7];

    insertion_sort(int32, arr[..]);

    print_arr(arr[..]);

    return 0;
}
