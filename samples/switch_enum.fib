// switch/when dispatch over a plain enum.
// Expected output:
//   red
//   green
//   blue

comp Color: type = enum {
    Red,
    Green,
    Blue,
};

fn describe(c: Color) void {
    switch (c) {
        when .Red { std::os::write(1, "red\n"); }
        when .Green{ std::os::write(1, "green\n"); }
        when .Blue { std::os::write(1, "blue\n"); }
    };
}

fn main() int32 {
    describe(Color.Red);
    describe(Color.Green);
    describe(Color.Blue);
    return 0;
}
