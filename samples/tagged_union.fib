// Enum variants with payloads.
// Dotted brace constructors do not parse. Member calls below retain the
// payload values, but are only unresolved calls, not implemented enum
// constructors; construction and payload binding semantics remain unverified.
// Intended output (unverified; compiler pipeline unfinished):
//   int=7
//   bool=1
//   eof

Token: type = enum {
    Integer { value: uint32 },
    Boolean { flag: bool },
    EOF,
};

fn describe(t: Token) void {
    switch (t) {
        when .Integer(i) { libc::printf("int=%d\n", i.value); }
        when .Boolean(b) { libc::printf("bool=%d\n", b.flag as uint32); }
        when .EOF { libc::printf("eof\n"); }
    };
}

fn main() int32 {
    describe(Token.Integer(7));
    describe(Token.Boolean(true));
    describe(Token.EOF);
    return 0;
}
