// Enum variants with payloads.
// Expected output:
//   int=7
//   bool=1
//   eof

comp Token: type = enum {
    Integer: uint32,
    Boolean: bool,
    EOF,
};

fn describe(t: Token) void {
    switch (t) {
        when .Integer(i) {
            args: [1]std::io::Arg = [std::io::Arg.Unsigned(i as uint64)];
            std::io::printf("int={}\n", args[..]);
        }
        when .Boolean(b) {
            args: [1]std::io::Arg = [std::io::Arg.Unsigned(b as uint64)];
            std::io::printf("bool={}\n", args[..]);
        }
        when .EOF { std::io::print("eof\n"); }
    };
}

fn main() int32 {
    describe(Token.Integer(7));
    describe(Token.Boolean(true));
    describe(Token.EOF);
    return 0;
}
