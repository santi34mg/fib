import std::libc
import std::string
import std::io::fd::{FileDescriptor, stdin, stdout, stderr}

fn stdin_stream() FileDescriptor {
    return stdin();
}

fn stdout_stream() FileDescriptor {
    return stdout();
}

fn stderr_stream() FileDescriptor {
    return stderr();
}

fn read_line(fd: FileDescriptor) @string {
    buf: @string = libc::malloc(256 as @uint8) as @string;
    bytes: *@char = buf as *@char;
    i: @uint8 = 0;
    for (;;) {
        ch: @int4 = libc::getchar();
        if ch == '\n' as @int4 || ch == -1 as @int4 { break; };
        bytes.[i] = ch as @char;
        i = i + 1;
    };
    bytes.[i] = 0 as @char;
    return buf;
}

fn read_all(fd: FileDescriptor) @string {
    buf: @char[256];
    result: @string = libc::malloc(256 as @uint8) as @string;
    result_bytes: *@char = result as *@char;
    result_len: @uint8 = 0;
    for (;;) {
        n: @uint8 = libc::read(fd.fd, buf as *@void, 256);
        if n == 0 as @uint8 { break; };
        i: @uint8 = 0;
        for (;;) {
            if i >= n { break; };
            result_bytes.[result_len] = buf.[i];
            result_len = result_len + 1;
            i = i + 1;
        };
    };
    result_bytes.[result_len] = 0 as @char;
    return result;
}

fn write_all(fd: FileDescriptor, s: @string) @void {
    libc::write(fd.fd, s as *@void, libc::strlen(s));
}

fn write_bytes(fd: FileDescriptor, data: *@void, size: @uint8) @uint8 {
    return libc::write(fd.fd, data, size);
}
