comp os := std::os;
comp memory := std::memory;

fn main() int32 {
    pid := os::syscall0(39);
    if pid <= 0 { return 1; };
    if os::syscall1(39, 1) != pid || os::syscall2(39, 1, 2) != pid
        || os::syscall3(39, 1, 2, 3) != pid || os::syscall4(39, 1, 2, 3, 4) != pid
        || os::syscall5(39, 1, 2, 3, 4, 5) != pid || os::syscall6(39, 1, 2, 3, 4, 5, 6) != pid { return 2; };
    switch (os::getpid()) {
        when .Ok(p) { if p.value as int64 != pid { return 3; }; }
        when .Err(e) { return 4; }
    };
    switch (os::close(-1)) {
        when .Ok { return 5; }
        when .Err(e) { if e.error != 9 { return 6; }; }
    };
    switch (os::openat(-100, c"/fib-stdlib-test-missing/path", 0, 0)) {
        when .Ok(p) { os::close(p.value); return 7; }
        when .Err(e) { if e.error != 2 { return 8; }; }
    };
    switch (os::mmap(null, 4096, 3, 34, -1, 0)) {
        when .Ok(mapping) {
            pointer := mapping.value;
            defer { os::munmap(pointer, 4096); };
            (pointer*) = 42;
            if (pointer*) != 42 { return 9; };
            buffer := memory::slice_from_parts(pointer, 16);
            if buffer.len != 16 { return 10; };
            switch (os::openat(-100, c"/dev/zero", 0, 0)) {
                when .Ok(file) {
                    defer { os::close(file.value); };
                    switch (os::read(file.value, buffer)) {
                        when .Ok(count) { if count.value != 16 || (pointer*) != 0 { return 11; }; }
                        when .Err(e) { return 12; }
                    };
                }
                when .Err(e) { return 13; }
            };
            switch (os::openat(-100, c"/dev/null", 0, 0)) {
                when .Ok(file) {
                    defer { os::close(file.value); };
                    switch (os::read(file.value, buffer)) {
                        when .Ok(count) { if count.value != 0 { return 14; }; }
                        when .Err(e) { return 15; }
                    };
                }
                when .Err(e) { return 16; }
            };
        }
        when .Err(e) { return 17; }
    };
    switch (os::mmap(null, 4096, 3, 34, -1, 1)) {
        when .Ok(mapping) { os::munmap(mapping.value, 4096); return 18; }
        when .Err(e) { if e.error != 22 { return 19; }; }
    };
    switch (os::write(1, "std syscalls\n"[..])) {
        when .Ok(count) { if count.value != 13 { return 20; }; }
        when .Err(e) { return 21; }
    };
    return 0;
}
